#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	cargo build --release --workspace

override_dh_auto_install:
	install -Dm755 target/release/itp $(DESTDIR)/usr/bin/itp
	install -Dm755 target/release/itp-grep $(DESTDIR)/usr/bin/itp-grep
	install -Dm755 target/release/itp-sed $(DESTDIR)/usr/bin/itp-sed
	install -Dm755 target/release/itp-awk $(DESTDIR)/usr/bin/itp-awk

override_dh_auto_test:
	cargo test --workspace

override_dh_auto_clean:
	cargo clean
